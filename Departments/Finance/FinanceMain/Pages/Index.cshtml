@page
@model IndexModel
@{
    ViewData["Title"] = "Finance Center";
}

<section class="page-heading">
    <div>
        <div class="eyebrow">Campus Services</div>
        <h1>Finance Center</h1>
    </div>
</section>

<div class="surface p-4 p-md-5">
    <p class="lead mb-4">Review payment activity, download records, and manage financial service requests from one entry point.</p>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="surface p-3 h-100">
                <h2>Service overview</h2>
                <ul class="mb-0">
                    <li>Payment status</li>
                    <li>Invoices and statements</li>
                    <li>Student accounts</li>
                    <li>Download reports</li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="surface p-3 h-100">
                <h2>Support notes</h2>
                <p class="mb-0">This interface is intentionally kept front-end only until the finance data contract and approval flow are finalized.</p>
            </div>
        </div>
    </div>
</div>
