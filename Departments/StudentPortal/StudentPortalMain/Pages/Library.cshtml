@page
@model StudentPortalMain.Pages.LibraryModel
@{
    ViewData["Title"] = "Library Services & Reservations";
    ViewData["ActivePage"] = "Library";
}

<div class="portal-page-header">
    <div>
        <div style="font-size:12px; font-weight:700; color:var(--nu-blue); text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">
            Learning Resource Center
        </div>
        <h1 class="portal-page-title">University Library &amp; Book Reservations</h1>
        <p class="portal-page-subtitle">
            Search physical and digital catalog, reserve reference books, and track due dates.
        </p>
    </div>
</div>

<div class="row" style="display:flex; flex-wrap:wrap; gap:24px; margin:0 -12px;">
    <!-- Book Reservation Form -->
    <div style="flex: 1 1 360px; min-width:300px;">
        <div class="portal-card">
            <div class="portal-card-header">
                <h3 class="portal-card-title">
                    <span>📖</span> Reserve Library Material
                </h3>
            </div>
            <div class="portal-card-body">
                <form method="post" asp-page-handler="Reserve">
                    <div class="form-group">
                        <label class="form-label">Book Title / Edition:</label>
                        <input type="text" name="bookTitle" class="form-control" placeholder="e.g. Operating Systems: Three Easy Pieces" required />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Author / Publisher:</label>
                        <input type="text" name="bookAuthor" class="form-control" placeholder="e.g. Arpaci-Dusseau / Pearson" />
                    </div>

                    <div style="background:var(--nu-surface-alt); border:1px solid var(--nu-border); border-radius:var(--nu-radius-sm); padding:10px 12px; margin-bottom:16px; font-size:12px; color:var(--nu-text-muted);">
                        📌 <strong>Reservation Policy:</strong> Reserved books are held for 48 hours at 3rd Floor Circulation Desk. Standard borrowing period: 7 days.
                    </div>

                    <button type="submit" class="btn-nu btn-nu-gold" style="width:100%;">
                        Place Book Reservation
                    </button>
                </form>
            </div>
        </div>

        <div class="portal-card">
            <div class="portal-card-header">
                <h3 class="portal-card-title">
                    <span>💳</span> Library Card Status
                </h3>
            </div>
            <div class="portal-card-body" style="font-size:12.5px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                    <span>Account Standing:</span>
                    <span class="badge-status badge-success">✓ Active &amp; Cleared</span>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                    <span>Borrowing Limit:</span>
                    <strong>Up to 5 titles</strong>
                </div>
                <div style="display:flex; justify-content:space-between;">
                    <span>Overdue Fines:</span>
                    <strong style="color:#15803d;">₱0.00</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Reservations & Borrowed Books -->
    <div style="flex: 2 1 550px; min-width:320px;">
        <div class="portal-card">
            <div class="portal-card-header">
                <h3 class="portal-card-title">
                    <span>📚</span> Current Borrowed Books &amp; Reservations
                </h3>
            </div>
            <div class="portal-card-body" style="padding:0;">
                @if (Model.Reservations.Any())
                {
                    <div class="portal-table-responsive">
                        <table class="portal-table">
                            <thead>
                                <tr>
                                    <th>Book Title</th>
                                    <th>Author</th>
                                    <th>Reserved Date</th>
                                    <th>Return Due Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Reservations)
                                {
                                    <tr>
                                        <td><strong style="color:var(--nu-blue-dark);">@r.BookTitle</strong></td>
                                        <td style="font-size:12.5px; color:var(--nu-text-muted);">@r.BookAuthor</td>
                                        <td style="font-size:12px;">@r.ReservationDate.ToString("MMM dd, yyyy")</td>
                                        <td style="font-size:12px;">
                                            <strong style="color:@(r.DueDate < DateTime.UtcNow ? "#b91c1c" : "inherit");">
                                                @r.DueDate.ToString("MMM dd, yyyy")
                                            </strong>
                                        </td>
                                        <td>
                                            <span class="badge-status @(r.Status == "Active" ? "badge-info" : (r.Status == "Returned" ? "badge-success" : "badge-danger"))">
                                                @r.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div style="padding:48px; text-align:center; color:var(--nu-text-muted);">
                        <p>No active library reservations or borrowed books.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
