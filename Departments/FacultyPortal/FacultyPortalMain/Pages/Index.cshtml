@page
@model IndexModel
@{
    ViewData["Title"] = "Faculty Portal";
}

<section class="page-heading">
    <div>
        <div class="eyebrow">Campus Services</div>
        <h1>Faculty Portal</h1>
    </div>
</section>

<div class="surface p-4 p-md-5">
    <p class="lead mb-4">Manage department work items, schedules, and faculty operations from a unified workspace.</p>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="surface p-3 h-100">
                <h2>Daily actions</h2>
                <ul class="mb-0">
                    <li>Faculty dashboard</li>
                    <li>Course coordination</li>
                    <li>Approval requests</li>
                    <li>Communication board</li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="surface p-3 h-100">
                <h2>Department notes</h2>
                <p class="mb-0">This workbench is configured as a front-end interface and is intentionally non-functional until the backend contract is approved.</p>
            </div>
        </div>
    </div>
</div>
