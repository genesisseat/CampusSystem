@page
@{ ViewData["Title"] = "Attendance"; }
<div class="page-heading"><div><span class="eyebrow">Class operations</span><h1>Attendance sheet</h1><p class="text-muted">Mark attendance for each class meeting.</p></div><input class="form-control w-auto" type="date" /></div>
<div class="toolbar"><select class="form-select w-auto"><option>CS 201 · Section A</option></select><span class="badge text-bg-success">Present 0</span><span class="badge text-bg-light">Absent 0</span></div>
<div class="table-responsive surface"><table class="table align-middle mb-0"><thead><tr><th>Student</th><th>Today</th><th>Previous session</th><th>Notes</th></tr></thead><tbody><tr><td colspan="4" class="empty-state">No attendance records for this class.</td></tr></tbody></table></div>