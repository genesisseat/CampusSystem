@page
@{
    ViewData["Title"] = "Attendance";
    ViewData["ActivePage"] = "Attendance";
}

<div class="portal-page-header">
    <div>
        <div class="portal-eyebrow">Class sessions</div>
        <h1 class="portal-page-title">Attendance</h1>
        <p class="portal-page-subtitle">Mark attendance for one class session. Demo data only.</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn-nu btn-nu-gold">💾 Save attendance</button>
    </div>
</div>

<div class="portal-card">
    <div class="portal-card-header">
        <h3 class="portal-card-title"><span>✅</span> Attendance sheet</h3>
    </div>
    <div class="toolbar">
        <select class="form-select" aria-label="Section">
            <option>IT301-A Computer Networks</option>
            <option>IT402-B Network Security</option>
        </select>
        <input type="date" class="form-control" aria-label="Session date">
        <input type="text" class="form-control" placeholder="Topic covered" aria-label="Topic">
    </div>
    <div class="portal-table-responsive">
        <table class="portal-table">
            <thead>
                <tr><th>Student</th><th class="col-status">Status</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td class="cell-title">Sample Student 1</td>
                    <td><select class="form-select" aria-label="Status for Sample Student 1"><option>Present</option><option>Late</option><option>Absent</option><option>Excused</option></select></td>
                </tr>
                <tr>
                    <td class="cell-title">Sample Student 2</td>
                    <td><select class="form-select" aria-label="Status for Sample Student 2"><option>Present</option><option>Late</option><option>Absent</option><option>Excused</option></select></td>
                </tr>
                <tr>
                    <td class="cell-title">Sample Student 3</td>
                    <td><select class="form-select" aria-label="Status for Sample Student 3"><option>Present</option><option>Late</option><option>Absent</option><option>Excused</option></select></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
