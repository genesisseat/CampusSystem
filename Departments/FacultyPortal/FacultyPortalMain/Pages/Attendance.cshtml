@page
@model FacultyPortalMain.Pages.AttendanceModel
@{
    ViewData["Title"] = "Attendance";
    ViewData["ActivePage"] = "Attendance";
}

<div class="portal-page-header">
    <div>
        <div class="portal-eyebrow">Class sessions</div>
        <h1 class="portal-page-title">Attendance Tracking</h1>
        <p class="portal-page-subtitle">Track and mark live student attendance synchronized with MySQL.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div style="background:#e8f5e9; border:1px solid #81c784; color:#2e7d32; padding:12px 16px; border-radius:8px; margin-bottom:1.5rem; font-weight:500;">
        ✅ @Model.Message
    </div>
}

<div class="portal-card">
    <div class="portal-card-header">
        <h3 class="portal-card-title"><span>✅</span> Session Attendance Sheet</h3>
    </div>
    <form method="get" class="toolbar" style="display:flex; gap:12px; align-items:center; flex-wrap:wrap; padding:1rem 1.5rem; background:#f8fafc; border-bottom:1px solid #e2e8f0;">
        <div style="display:flex; flex-direction:column; gap:4px;">
            <label style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:#64748b;">Class Section</label>
            <select name="offeringId" class="form-select" onchange="this.form.submit()" style="min-width:260px;">
                @foreach (var off in Model.Offerings)
                {
                    <option value="@off.Id" selected="@(off.Id == Model.SelectedOfferingId)">@off.SectionCode — @off.SubjectName</option>
                }
            </select>
        </div>
        <div style="display:flex; flex-direction:column; gap:4px;">
            <label style="font-size:0.75rem; font-weight:600; text-transform:uppercase; color:#64748b;">Session Date</label>
            <input type="date" name="date" class="form-control" value="@Model.SessionDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()">
        </div>
    </form>

    <form method="post" style="padding:1.5rem;">
        <input type="hidden" name="offeringId" value="@Model.SelectedOfferingId" />
        <input type="hidden" name="sessionDate" value="@Model.SessionDate.ToString("yyyy-MM-dd")" />

        <div style="margin-bottom:1.25rem;">
            <label style="font-size:0.85rem; font-weight:600; color:#334155; margin-bottom:4px; display:block;">Session Discussion Topic</label>
            <input type="text" name="topic" class="form-control" placeholder="e.g. Chapter 4: Relational Algebra & MySQL Joins" style="max-width:500px;">
        </div>

        <div class="portal-table-responsive">
            <table class="portal-table">
                <thead>
                    <tr>
                        <th style="width:140px;">Student Number</th>
                        <th>Student Name</th>
                        <th class="col-status" style="width:180px;">Attendance Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Students.Count == 0)
                    {
                        <tr>
                            <td colspan="3" style="text-align:center; padding:2rem; color:#64748b;">No active students found in this section.</td>
                        </tr>
                    }
                    else
                    {
                        @for (int i = 0; i < Model.Students.Count; i++)
                        {
                            var s = Model.Students[i];
                            <tr>
                                <td><span style="font-family:monospace; font-weight:600; color:#0b2545;">@s.StudentNumber</span></td>
                                <td class="cell-title">@s.StudentName</td>
                                <td>
                                    <input type="hidden" name="studentIds" value="@s.StudentId" />
                                    <select name="statuses" class="form-select" style="font-weight:600; font-size:0.85rem;">
                                        <option value="Present" selected="@(s.Status == "Present")">✅ Present</option>
                                        <option value="Late" selected="@(s.Status == "Late")">⏳ Late</option>
                                        <option value="Absent" selected="@(s.Status == "Absent")">❌ Absent</option>
                                        <option value="Excused" selected="@(s.Status == "Excused")">📋 Excused</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div style="margin-top:1.5rem; text-align:right;">
            <button type="submit" class="btn-nu btn-nu-gold" style="padding:10px 24px; font-weight:700;">💾 Save Attendance to MySQL</button>
        </div>
    </form>
</div>
