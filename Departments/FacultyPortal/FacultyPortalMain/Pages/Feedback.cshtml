@page
@{ ViewData["Title"] = "Assignment Feedback"; }
<div class="page-heading"><div><span class="eyebrow">Student feedback</span><h1>Assignment comments</h1><p class="text-muted">Review submissions and prepare feedback.</p></div><button class="btn btn-dark">Post feedback</button></div>
<div class="row g-4"><div class="col-lg-5"><div class="surface p-4"><h2 class="h5">Submissions</h2><div class="empty-state">No submissions waiting for review.</div></div></div><div class="col-lg-7"><div class="surface p-4"><label class="form-label">Feedback</label><textarea class="form-control" rows="8" placeholder="Write a private comment"></textarea><div class="d-flex justify-content-between mt-3"><span class="text-muted small">Draft · not published</span><button class="btn btn-outline-dark">Save draft</button></div></div></div></div>