@page
@{ ViewData["Title"] = "Class Roster"; }
<div class="page-heading"><div><span class="eyebrow">Faculty workspace</span><h1>Class roster</h1><p class="text-muted">Choose a class to review enrolled students.</p></div><select class="form-select w-auto"><option>CS 201 · Data Structures</option><option>ENG 110 · Composition</option></select></div>
<div class="toolbar"><input class="form-control" placeholder="Search students" /><button class="btn btn-dark">Export roster</button></div>
<div class="table-responsive surface"><table class="table align-middle mb-0"><thead><tr><th>Student</th><th>ID</th><th>Program</th><th>Status</th></tr></thead><tbody><tr><td colspan="4" class="empty-state">No students loaded for this class.</td></tr></tbody></table></div>