@page
@model IndexModel
@{
    ViewData["Title"] = "Registrar Services";
}

<section class="page-heading">
    <div>
        <div class="eyebrow">Campus Services</div>
        <h1>Registrar Services</h1>
    </div>
</section>

<div class="surface p-4 p-md-5">
    <p class="lead mb-4">Access registration and academic records tools through a clean, service-focused dashboard.</p>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="surface p-3 h-100">
                <h2>Student records</h2>
                <ul class="mb-0">
                    <li>Registration status</li>
                    <li>Transcript requests</li>
                    <li>Verification checks</li>
                    <li>Academic records</li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="surface p-3 h-100">
                <h2>Office updates</h2>
                <p class="mb-0">Controls and data integrations remain placeholder-only until confirmation from the registrar team and system owners.</p>
            </div>
        </div>
    </div>
</div>
