@page
@model IndexModel
@{
    ViewData["Title"] = "Library Services";
}

<section class="page-heading">
    <div>
        <div class="eyebrow">Campus Services</div>
        <h1>Library Services</h1>
    </div>
</section>

<div class="surface p-4 p-md-5">
    <p class="lead mb-4">Access catalog tools, circulation records, and service updates in one place.</p>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="surface p-3 h-100">
                <h2>Quick access</h2>
                <ul class="mb-0">
                    <li>Catalog search</li>
                    <li>Resource detail lookup</li>
                    <li>Checkout history</li>
                    <li>Fines and fees</li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="surface p-3 h-100">
                <h2>Announcements</h2>
                <p class="mb-0">New acquisitions, digital access updates, and reservation notices are displayed here for students and staff.</p>
            </div>
        </div>
    </div>
</div>
